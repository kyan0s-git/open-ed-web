{
  "name": "open-ed-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "size": "node scripts/check-size.mjs",
    "pretest": "npm run fixtures",
    "verify": "npm run build && npm run size && npm test",
    "e2e": "npm run fixtures && npm run build && npm run build:server && npx playwright test",
    "vendor": "node scripts/vendor.mjs",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server-dist/node.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler@4 deploy",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@zip.js/zip.js": "^2.14.0",
    "dexie": "^4.4.6",
    "dompurify": "^3.2.7",
    "linkedom": "^0.18.13",
    "mathjax": "^4.1.3",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
