// Cloudflare Workers deployment: the web app as static assets plus the sync API.
// Setup is in docs/self-hosting.md. In short:
//   npx wrangler d1 create open-ed-web      # paste the database_id below
//   npm run deploy:cloudflare
{
  "name": "open-ed-web",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-ed-web",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "vars": {
    "SYNC_ALLOWED_ORIGINS": "*"
  }
}
