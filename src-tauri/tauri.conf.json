{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-ed-web",
  "version": "../package.json",
  "identifier": "org.openedweb.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "open-ed-web",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Study MIT OpenCourseWare courses offline",
    "longDescription": "Import MIT OpenCourseWare course downloads and study them as structured courses with spaced-repetition review, search, and optional end-to-end encrypted sync between devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
